NEWS_BLOCK_AFTER_MINUTES=30

# ATR Multipliers (per timeframe)
ATR_PERIOD=14
ATR_MULTIPLIER_M1=1.2
ATR_MULTIPLIER_M5=1.5
ATR_MULTIPLIER_M15=2.0
ATR_MULTIPLIER_M30=2.5
