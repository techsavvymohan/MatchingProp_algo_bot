# Session & Timezone Restrictions (False = 24/5 trade across all sessions)
ENABLE_SESSION_FILTER=False

# Sideways Market Avoidance Engine (avoid only sideways situation)
ENABLE_SIDEWAYS_FILTER=True
SIDEWAYS_CHOP_THRESHOLD=61.8
SIDEWAYS_ADX_THRESHOLD=22.0
SIDEWAYS_BANDWIDTH_SQUEEZE_PCT=25.0

# Quant Trading Strategies (adapted from je-suis-tm/quant-trading)
ENABLE_AO_SAUCER=True
ENABLE_HA_FILTER=True
ENABLE_PSAR_TRAILING=True

# London Strategic Edge (LSE) Live WebSocket & Vault API
ENABLE_LSE_FEED=True
LSE_API_KEY=lse_live_31f53152fae3fd762294057c154f19b2
LSE_WS_URL=wss://data-ws.londonstrategicedge.com
LSE_HTTP_URL=https://api.londonstrategicedge.com/vault

# TradingView Library Integration (tradingview-ta)
